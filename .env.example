# ============================================================
# LEADFORGE — Configuración de Variables de Entorno
# Copiar este archivo como .env y completar los valores
# ============================================================

# --- IDENTIFICACIÓN DEL CLIENTE ---
# Cada instalación tiene un cliente_id único (UUID)
# Obtenerlo del dashboard de LeadForge o generar con: python -c "import uuid; print(uuid.uuid4())"
CLIENTE_ID=

# --- SUPABASE ---
# Obtener en: https://app.supabase.com → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_KEY=eyJhbGci...    # Service Role key — tiene acceso total, NO compartir

# --- APIFY ---
# Obtener en: https://console.apify.com → Settings → Integrations → API token
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx
# Actor ID del Google Maps scraper (compass/crawler-google-places)
APIFY_ACTOR_ID=compass/crawler-google-places
#
# Modo MCP (Model Context Protocol):
#   false = REST API directa (default, sin dependencias extra)
#   true  = Apify MCP HTTP endpoint — un solo call, sin polling manual
#   URL MCP: https://mcp.apify.com/?tools=actors,docs,compass/crawler-google-places
APIFY_USE_MCP=false

# --- ANYMAIL FINDER ---
# Obtener en: https://anymailfinder.com/account/api
ANYMAIL_API_KEY=

# --- ANTHROPIC (Claude API) ---
# Obtener en: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# --- INSTANTLY.AI ---
# Obtener en: https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=
# Webhook secret (configurar en Instantly → Settings → Webhooks)
INSTANTLY_WEBHOOK_SECRET=

# --- TELEGRAM ---
# Bot token: hablar con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID de Zenon (master): hablar con @userinfobot para obtenerlo
TELEGRAM_MASTER_CHAT_ID=

# --- YCLOUD (WhatsApp) ---
# Obtener en: https://ycloud.com/dashboard → API Settings
YCLOUD_API_KEY=

# --- ENCRIPTACIÓN ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CONFIGURACIÓN DEL PIPELINE ---
# Máximo de resultados por búsqueda Apify
APIFY_MAX_PLACES=50
# Máximo de emails por empresa (de Anymail Finder)
MAX_EMAILS_PER_COMPANY=2
# Días antes de considerar un cache como expirado
CACHE_EXPIRY_DAYS=45
# Número de llamadas paralelas a Anymail Finder
ANYMAIL_CONCURRENT_CALLS=3
# Delay en segundos entre categorías en la cola
QUEUE_DELAY_SECONDS=5

# --- PROTECCIÓN DE DOMINIOS ---
# Porcentaje de bounces que activa la pausa automática
BOUNCE_RATE_THRESHOLD=3.0
# Porcentaje de spam que activa la pausa automática
SPAM_RATE_THRESHOLD=0.1
# Créditos de Anymail Finder que activan la alerta de recarga
ANYMAIL_CREDITS_ALERT_THRESHOLD=100

# --- SERVIDOR WEB (Fase 4) ---
# Puerto del dashboard web local
DASHBOARD_PORT=5000
# Clave secreta para sesiones
SECRET_KEY=cambiar_por_una_cadena_aleatoria_larga

# --- AMBIENTE ---
# development | production
ENVIRONMENT=development
